  "dock_pebble": {
    "title": "石阶水边",
    "start": "look",
    "nodes": {
      "look": {
        "type": "choice",
        "speaker": "player_yanqiu",
        "text": "脚边有几颗干燥的小石子。右侧那片水面离船远些。",
        "options": [
          {
            "id": "toss_pebble",
            "label": "拾一颗，轻投向空水面",
            "next": "splash",
            "action": "toss_dock_pebble",
            "conditions": {}
          },
          {
            "id": "leave_water",
            "label": "只看看河面",

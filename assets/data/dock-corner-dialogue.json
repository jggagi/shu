{
  "dock_keeper_talk": {
    "title": "茶商 · 壶边闲话",
    "start": "ask",
    "nodes": {
      "ask": {
        "type": "choice",
        "speaker": "dock_tea_keeper",
        "text": "歇脚，还是看船？石阶上慢些，别踩湿了。",
        "options": [
          {
            "id": "ask_boat",
            "label": "问问这条船",
            "next": "boat",
            "action": "",
            "conditions": {}
          },
          {
            "id": "ask_tea",
            "label": "看看茶棚",
            "next": "tea",
            "action": "",
            "conditions": {}
          },
          {
            "id": "leave_keeper",
            "label": "先四处走走",
            "next": "end",
            "action": "",
            "conditions": {}
          }
        ]
      },
      "boat": {
        "type": "say",
        "speaker": "dock_tea_keeper",
        "text": "船还系着。看景去石阶上，投石时离船远些。",
        "next": "end"
      },
      "tea": {
        "type": "say",
        "speaker": "dock_tea_keeper",
        "text": "茶壶在篷下，别碰壶口。柳树那头背阴，想歇脚就去那边。",
        "next": "end"
      },
      "end": {
        "type": "end",
        "text": "你向茶商点点头，继续在岸边走走。",
        "set_flags": {
          "dock_keeper_met": true
        }
      }
    }
  },

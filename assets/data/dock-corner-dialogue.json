            "conditions": {}
          }
        ]
      },
      "splash": {
        "type": "say",
        "speaker": "player_yanqiu",
        "text": "石子落在船外的水面上，涟漪慢慢散开。",
        "next": "end"
      },
      "end": {
        "type": "end",
        "text": "你在石阶上站稳，望了一眼河面。",
